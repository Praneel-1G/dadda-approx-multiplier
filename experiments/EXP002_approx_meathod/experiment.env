# Experiment manifest.
# Keep this file portable: do not put machine-specific absolute paths here.

EXPERIMENT_ID=EXP002
DESIGN_NAME=approx_dadda_d1
TOP_MODULE=approx_dadda_d1

# Update these two module names to the real testbench modules.
RTL_TB_MODULE=tb
GATE_TB_MODULE=gate_tb

# Space-separated RTL source paths, relative to the repository root.
# Example:
# RTL_SOURCES="rtl/exact/exact_dadda_w_comp.sv rtl/common/full_adder.sv"
RTL_SOURCES="rtl/approx/d1/approx_dadda_d1.sv rtl/exact/exact4_2_comp.sv rtl/approx/d1/d1_compressor_block.sv rtl/approx/d1/approx4_2_comp_d1.sv rtl/common/ha.sv rtl/common/fa.sv rtl/common/input_reorder.sv  "

PLATFORM=sky130hd
INPUT_WIDTH=8
OUTPUT_WIDTH=16
EXPECTED_VECTORS=65536

RTL_SCOPE=tb_approx_meathod/dut
GATE_SCOPE=tb_gate_approx_meathod/dut

# This must match the ORFS results path created by run_pd.sh.
ORFS_DESIGN_PATH=sky130hd/approx_dadda_d1/base

CLOCK_PERIOD_NS=2.000
